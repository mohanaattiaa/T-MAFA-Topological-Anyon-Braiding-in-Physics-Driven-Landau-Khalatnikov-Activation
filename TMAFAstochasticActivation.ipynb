
import numpy as np
import torch
import torch.nn as nn
import matplotlib.pyplot as plt
import matplotlib.animation as animation

class TMAFASolver:
    """
    Stochastic Finite Difference Method (SFDM) solver for the T-MAFA System.
    Integrates classical MAFA ferroelectric dynamics with Anyon Braid Topological modulation.
    """
    def __init__(self, Nx=20, Ny=20, dt=0.01, gamma=1.0, kappa=1.2, temperature=0.05):
        self.Nx = Nx
        self.Ny = Ny
        self.dt = dt
        self.gamma = gamma
        self.kappa = kappa        # Strength of Topological Protection (T-component)
        self.temp = temperature   # Thermal Noise amplitude (Fluctuation-Dissipation theorem proxy)

        # Calibrated material coefficients for the MAFA backbone (PZT core)
        self.alpha = -1.2
        self.beta = 0.6
        self.nu = 0.2

    def _compute_topological_gradient(self, P, W_factor):
        """
        Calculates the Anyon Braid Modulation (T-component).
        Creates the fine-grained discrete topological sub-wells.
        """
        return np.sin(5 * np.pi * P * W_factor) + 0.2 * np.sign(P)

    def solve_step(self, P, E, W_factor=2.5):
        """
        Executes a single stochastic Langevin-type time step update for T-MAFA.
        """
        # 1. Classical MAFA Backbone Gradient
        grad_classical = 2 * self.alpha * P + 4 * self.beta * (P**3) + 6 * self.nu * (P**5) - E

        # 2. Topological Modulation Gradient (T-modifier)
        grad_topo = self._compute_topological_gradient(P, W_factor)

        # 3. Thermal Fluctuation (Noise)
        thermal_noise = np.random.normal(0, self.temp, size=(self.Nx, self.Ny))

        # 4. Total Coupled T-MAFA Dynamic Update
        P_next = P - (self.dt / self.gamma) * (grad_classical + self.kappa * grad_topo) + np.sqrt(self.dt) * thermal_noise
        return P_next

# --- Dynamic Real-Time T-MAFA Simulation Framework ---
if __name__ == "__main__":
    print("[+] Initializing Advanced Stochastic T-MAFA Render Engine...")

    Nx, Ny = 25, 25
    solver = TMAFASolver(Nx=Nx, Ny=Ny, kappa=1.5, temperature=0.04) # High kappa = High T-protection
    W_factor = 2.5
    total_frames = 200

    test_fields = [-1.6, -0.5, 0.5, 1.6]
    colors = ['navy', 'dodgerblue', 'orange', 'crimson']

    p_states = [np.random.uniform(-0.02, 0.02, (Nx, Ny)) for _ in test_fields]
    e_fields = [np.ones((Nx, Ny)) * f for f in test_fields]
    history = {f: [] for f in test_fields}

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))
    fig.suptitle('Dynamic Relaxation & Stochastic Phase-Field Framework of T-MAFA Topology', fontsize=12, fontweight='bold')

    lines = []
    for f, color in zip(test_fields, colors):
        line, = ax1.plot([], [], label=f'T-MAFA Active Response ($E = {f}$)', color=color, lw=2)
        lines.append(line)

    ax1.set_xlim(0, total_frames)
    ax1.set_ylim(-1.2, 1.2)
    ax1.set_xlabel('Simulation Time Steps ($t$)', fontsize=10)
    ax1.set_ylabel('Mean T-MAFA Polarization $\\langle P \\rangle$', fontsize=10)
    ax1.grid(True, linestyle='--', alpha=0.5)
    ax1.legend(loc='lower right')

    im = ax2.imshow(p_states[-1], cmap='bwr', vmin=-1, vmax=1, origin='lower')
    ax2.set_title('Spatial T-MAFA Mesh Grid Matrix $\\mathbf{P}_{(x,y)}$ ($E = 1.6$)', fontsize=10)
    fig.colorbar(im, ax=ax2, label='Local Sub-Well Polarization Magnitude')

    def animate(frame):
        global p_states
        for idx, (f, E_tensor) in enumerate(zip(test_fields, e_fields)):
            p_states[idx] = solver.solve_step(p_states[idx], E_tensor, W_factor)
            mean_p = np.mean(p_states[idx])
            history[f].append(mean_p)
            lines[idx].set_data(range(len(history[f])), history[f])

        im.set_array(p_states[-1])
        return lines + [im]

    print("[+] Rendering dynamic stochastic frames. Please wait...")
    ani = animation.FuncAnimation(fig, animate, frames=total_frames, interval=20, blit=True, repeat=False)

    output_filename = "animated_tmafa_advanced.gif"
    ani.save(output_filename, writer='pillow', fps=30)
    plt.close()

    print(f"[+] Success! Animation saved completely as: '{output_filename}'")

    # --- Auto-Download Trigger for Google Colab environments ---
    try:
        from google.colab import files
        print("[+] Colab environment detected. Initializing automatic file download...")
        files.download(output_filename)
    except ImportError:
        print(f"[+] Local environment detected. Find your file '{output_filename}' in your current working directory.")
